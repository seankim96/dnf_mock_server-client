	$(MAKE) $(MAKESILENT) -f CMakeFiles/receive_buffer_test.dir/build.make CMakeFiles/receive_buffer_test.dir/tests/ReceiveBufferTest.cpp.i
.PHONY : tests/ReceiveBufferTest.cpp.i

tests/ReceiveBufferTest.s: tests/ReceiveBufferTest.cpp.s
.PHONY : tests/ReceiveBufferTest.s

# target to generate assembly for a file
tests/ReceiveBufferTest.cpp.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/receive_buffer_test.dir/build.make CMakeFiles/receive_buffer_test.dir/tests/ReceiveBufferTest.cpp.s
.PHONY : tests/ReceiveBufferTest.cpp.s

